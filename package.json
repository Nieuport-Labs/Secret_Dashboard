{
  "name": "secret-dashboard",
  "description": "Secret Dashboard 1.9 — an entry point into Secret Network",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write --ignore-unknown .",
    "verify:chain": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/verify-chain.ts",
    "test:bridge": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/test-bridge.ts",
    "test:activity": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/test-activity.ts",
    "test:proposal": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/test-proposal.ts",
    "test:errors": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/test-errors.ts",
    "test:multisig": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/test-multisig.ts",
    "test:profile": "node --experimental-strip-types --no-warnings --import ./scripts/register-alias.mjs scripts/test-profile.ts",
    "test:settings": "node --experimental-transform-types --no-warnings --import ./scripts/register-alias.mjs scripts/test-settings.ts",
    "test:refill": "node --experimental-transform-types --no-warnings --import ./scripts/register-alias.mjs scripts/test-refill.ts"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.32.4",
    "@cosmjs/crypto": "^0.32.4",
    "@cosmjs/encoding": "^0.32.3",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.39.0",
    "@resvg/resvg-js": "^2.6.2",
    "@solar-republic/neutrino": "^1.9.0",
    "@vercel/edge": "^1.3.3",
    "@waku/message-encryption": "^0.0.38",
    "@waku/sdk": "^0.0.36",
    "cosmjs-types": "^0.9.0",
    "lucide-react": "^0.460.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "secretjs": "1.21.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
    "protobufjs": "^7.5.4",
    "elliptic": "^6.6.1",
    "uuid": "^11.1.1"
  }
}
